[Unit]
Description=Zoura backend (FastAPI/uvicorn, ENVIRONMENT=tbd)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=zoura
Group=zoura
WorkingDirectory=/opt/zoura/app
# Materialize .env from SSM Parameter Store on every start (instance role auth).
ExecStartPre=/opt/zoura/venv/bin/python /opt/zoura/bin/fetch_env.py
# --no-access-log: unstructured uvicorn.access lines are noise next to the
# structlog JSON (PRD checklist / monitoring note).
ExecStart=/opt/zoura/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
