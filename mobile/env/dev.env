# dev build defines — flutter run --dart-define-from-file=env/dev.env
#
# One committed file per environment (dev.env / tbd.env; prd.env at go-live).
# Everything here is CLIENT-SIDE config: it ships inside the app binary, so it
# is public by definition and safe to commit. Anything actually secret must
# never be a dart-define — server secrets live in backend/.env (gitignored) or
# SSM/Secrets Manager. All keys optional: absence selects the keyless/no-op
# provider (analytics log to console, OAuth buttons hidden).

# Backend base URL. Unset = platform-aware local dev default (localhost:8000 /
# 10.0.2.2:8000 on the Android emulator).
# API_BASE_URL=

# Google OAuth web ("server") client ID. Android ID tokens carry it as
# audience; iOS tokens instead carry the GIDClientID from ios/Runner/
# Info.plist. Both must be in the backend's GOOGLE_CLIENT_ID audience list
# or sign-in 401s. The button is hidden while this is unset.
GOOGLE_SERVER_CLIENT_ID=364249279816-jcqcrbvk9c9lebpk9qv42t1gb5bdeque.apps.googleusercontent.com

# Sentry crash reporting (DSN is a public client key). Unset = no-op reporter.
# SENTRY_ENVIRONMENT defaults by build mode (debug/release) when unset.
SENTRY_DSN=https://c0669c3c457d5a0344c8601154b35f50@o4511752498380800.ingest.us.sentry.io/4511752511422469

# PostHog analytics (phc_ project keys are public client keys). Unset = debug
# sink, events logged to console only. POSTHOG_HOST defaults to the US cloud.
POSTHOG_API_KEY=phc_xfzwvCHL5QFZJRe6mX7hmawBpiCw5MRzCbtqiT3Q6sdT

# Comma-separated features to turn OFF. Known names: apple_login, google_login,
# push. Mirrors the backend's DISABLED_FEATURES so one runbook covers both
# sides (backend-only names like `affiliate` don't apply here).
# DISABLED_FEATURES=
